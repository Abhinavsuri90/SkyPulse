# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
# OpenSky Network: opensky-network.org -> Account -> API Client (OAuth2 client-credentials)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# AviationStack free plan: aviationstack.com -> Dashboard -> API Access Key (100 calls/month)
AVIATIONSTACK_ACCESS_KEY=
